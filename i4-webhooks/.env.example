# Copier ce fichier en .env (jamais versionné) : cp .env.example .env

# Secret HMAC partagé avec l'émetteur du webhook.
# Valeur locale imposée par le sujet, sans valeur réelle : ne jamais la réutiliser ailleurs.
MATRICE_WEBHOOK_SECRET=matrice-local-only

# Adresse du partenaire simulé (lancé sur le port 8001, voir README).
PARTENAIRE_URL=http://127.0.0.1:8001
